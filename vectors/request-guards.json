      },
      "cases": [
        {
          "name": "same-origin multipart post where uploads are allowed",
          "request": {
            "method": "POST",
            "headers": {
              "sec-fetch-site": "same-origin",
              "sec-fetch-mode": "cors",
              "sec-fetch-dest": "empty",
              "origin": "https://pulse.example-tailnet.ts.net",
              "content-type": "multipart/form-data; boundary=x"
            }
          },
          "expect": {
            "allowed": true
          }
        },
        {
          "name": "JSON is still accepted alongside",
          "request": {
            "method": "POST",
            "headers": {
              "sec-fetch-site": "same-origin",
              "sec-fetch-mode": "cors",
              "sec-fetch-dest": "empty",
              "origin": "https://pulse.example-tailnet.ts.net",
              "content-type": "application/json"
            }
          },
          "expect": {
            "allowed": true
          }
        },
        {
          "name": "sibling multipart post",
          "request": {
            "method": "POST",
            "headers": {
              "sec-fetch-site": "same-site",
              "sec-fetch-mode": "cors",
              "sec-fetch-dest": "empty",
              "origin": "https://home.example-tailnet.ts.net",
              "content-type": "multipart/form-data; boundary=x"
            }
          },
          "expect": {
            "allowed": false,
            "reason": "not_same_origin"
          }
        },
        {
          "name": "urlencoded is still refused",
          "request": {
            "method": "POST",
            "headers": {
              "sec-fetch-site": "same-origin",
              "sec-fetch-mode": "cors",
              "sec-fetch-dest": "empty",
              "origin": "https://pulse.example-tailnet.ts.net",
              "content-type": "application/x-www-form-urlencoded"
            }
          },
          "expect": {
            "allowed": false,
            "reason": "content_type"
          }
        }
      ]
    }
  ]
}
